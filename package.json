{
  "name": "alpha-shadow",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant cloud POS engine for cafes and restaurants (multi-branch, multi-currency).",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:eslint": "ESLINT_FLAGS=unstable_native_nodejs_ts_config eslint .",
    "lint": "npm run typecheck && npm run lint:eslint && npm run check:roles",
    "check:roles": "node tools/check-role-compare.ts",
    "check:roles:selftest": "node tools/check-role-compare.ts --self-test",
    "build": "tsc -p tsconfig.build.json",
    "test": "ESLINT_FLAGS=unstable_native_nodejs_ts_config vitest run",
    "test:unit": "ESLINT_FLAGS=unstable_native_nodejs_ts_config vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@typescript-eslint/rule-tester": "8.69.0",
    "@typescript-eslint/utils": "8.69.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.10.0",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
