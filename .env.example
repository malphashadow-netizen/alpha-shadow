# Copy to `.env` for local development. `.env` is git-ignored; never commit real values.
# Phase 0 defines only the test-database override. Runtime secrets (JWT keys,
# PIN_HASH_PEPPER, DATABASE_URL for app_login / app_batch roles) are added in
# their phases — and every one of them is REQUIRED at boot (fail closed, no fallback).

# Optional: point integration/contract tests at an existing PostgreSQL instead of
# the embedded server Vitest starts automatically. Must be a disposable database.
# TEST_DATABASE_URL=postgresql://alpha_shadow_test:local-test-only@127.0.0.1:54329/alpha_shadow_test
