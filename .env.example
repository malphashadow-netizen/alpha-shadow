# Copy to `.env` for local development. `.env` is git-ignored; never commit real values.
# Phase 0 defines only the test-database override. Runtime secrets are added per
# phase — and every one of them is REQUIRED at boot (fail closed, no fallback).
# A missing/empty/short secret makes the security composition root refuse to
# start with a 503 (Service Unavailable); secret VALUES are never echoed back
# in error messages or logs — only the variable name is reported.

# Optional: point integration/contract tests at an existing PostgreSQL instead of
# the embedded server Vitest starts automatically. Must be a disposable database.
# TEST_DATABASE_URL=postgresql://alpha_shadow_test:local-test-only@127.0.0.1:54329/alpha_shadow_test

# ── Database (Phase 1) ───────────────────────────────────────────────────────
# Least-privilege application role (app_login). Never the schema owner / superuser.
# DATABASE_URL=postgresql://app_login:<secret>@db.internal:5432/alpha_shadow?sslmode=require
# Schema-owner role used ONLY by tools/migrate.ts (never by the running app).
# MIGRATION_DATABASE_URL=postgresql://alpha_owner:<secret>@db.internal:5432/alpha_shadow?sslmode=require
# Pool capacity (optional; defaults documented in src/infrastructure/db/pool.ts).
# DATABASE_MAX_CONNECTIONS=100
# APP_INSTANCES=1

# ── Authentication & security (Phase 3) ──────────────────────────────────────
#
# DEDICATED least-privilege role for the global auth_audit_log table
# (app_audit — see migrations/roles/003_app_audit.sql). This is the single
# connection NOT routed through withTenantContext(); it can only EXECUTE the
# record_auth_attempt() / count_recent_auth_failures() SECURITY DEFINER
# functions. REQUIRED whenever the auth engine is enabled.
# AUDIT_DATABASE_URL=postgresql://app_audit:<secret>@db.internal:5432/alpha_shadow?sslmode=require
#
# PIN pepper (HMAC-SHA256). REQUIRED: base64/standard-encoded random material
# that decodes to AT LEAST 32 bytes (256 bits), e.g. `openssl rand -base64 32`.
# An empty or too-short value is treated as missing and fails boot with 503.
# The value must never appear in any error message or log.
# PIN_HASH_PEPPER=<base64-from-openssl-rand-base64-32-or-more>
#
# JWT signing keypair — RS256 (RSA, >= 2048-bit) or ES256 (P-256). PEM only;
# the private key signs, the public key verifies. BOTH are REQUIRED and must be
# a matching, syntactically valid pair. The verifier PINS the algorithm
# allow-list {RS256, ES256} — an HS256 token is rejected even if structurally
# valid (algorithm-confusion defence). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub
# (or an EC P-256 keypair for ES256). Multi-line PEM is supplied via the secret
# manager; in .env use \n-escaped single-line values or your platform's secret
# file mount. Never commit real keys.
# JWT_PRIVATE_KEY_PEM=<PEM-private-key-multiline>
# JWT_PUBLIC_KEY_PEM=<PEM-public-key-multiline>
# Optional explicit algorithm selection (defaults derived from key type):
# JWT_ALGORITHM=RS256
